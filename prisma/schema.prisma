generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model banks {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code       String    @db.VarChar(255)
  name       String    @db.VarChar(255)
  currency   String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model blacklisted_words {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  word       String    @unique(map: "blacklisted_words_word_unique") @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model buzon_mensajes {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  producto_id       BigInt    @db.UnsignedBigInt
  disponibilidad    String    @db.VarChar(255)
  user_id_comprador BigInt    @db.UnsignedBigInt
  user_id_vendedor  BigInt    @db.UnsignedBigInt
  created_at        DateTime? @db.Timestamp(0)
  updated_at        DateTime? @db.Timestamp(0)
  foto              String    @db.VarChar(255)

  @@index([producto_id], map: "buzon_mensajes_producto_id_foreign")
  @@index([user_id_comprador], map: "buzon_mensajes_user_id_comprador_foreign")
  @@index([user_id_vendedor], map: "buzon_mensajes_user_id_vendedor_foreign")
}

model categorias {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  nombre          String    @db.VarChar(255)
  foto            String?   @db.VarChar(255)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
  slug            String    @db.VarChar(255)
  icono_categoria String?   @db.VarChar(255)
  comision        Decimal   @default(0.00) @db.Decimal(5, 2)
}

model chat_notificaciones {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  chatRoomId          String    @db.VarChar(255)
  userId              String    @db.VarChar(255)
  mensajes_pendientes Int       @default(0)
  ultimo_mensaje      DateTime? @default(now()) @db.Timestamp(0)

  @@unique([chatRoomId, userId], map: "unique_chat")
